# Lido por deps/build_app.sh. Caminhos relativos a esta pasta.
APP_DEFS="P8_APP CURL_STATICLIB _REENTRANT"
APP_INCS="deps deps/sdl2/include/SDL2 deps/curl/include"
APP_LIBS="deps/sdl2/lib/libSDL2.a deps/curl/lib/libcurl.a deps/curl/lib/libmbedtls.a
          deps/curl/lib/libmbedx509.a deps/curl/lib/libmbedcrypto.a
          deps/curl/lib/libeverest.a deps/curl/lib/libp256m.a"
# Objetos avulsos da libc.a do SDK (viram build/sdk_libc.a, linkada por
# ultimo). A libc.a inteira nao serve: o mman.o dela troca mprotect com
# PROT_EXEC por kernel_mprotect, que so existe em payloads do elfldr. O
# resto da libc vem dos stubs de libSceLibcInternal/libkernel.
SDK_LIBC_OBJS="emutls.o _setjmp.o gmtime.o pipe2.o passwd.o
               netdb.o mktemp.o strcasestr.o arc4random.o"
# netdb/mktemp/strcasestr: no app, os stubs delas apontam para
# libScePosixForWebKit, que o rtld nao carrega (slots nulos).
